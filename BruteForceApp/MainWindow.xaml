<Window x:Class="BruteForceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BruteForce Password Cracker" Height="650" Width="820"
        Background="#1A1A2E" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Dark button style -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="BorderBrush" Value="#C73652"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C73652"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A8C0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E94560"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⚡ BRUTE FORCE CRACKER" FontFamily="Consolas" FontSize="22"
                       FontWeight="Bold" Foreground="#E94560" HorizontalAlignment="Center"/>
            <TextBlock Text="SHA-256 · Multi-Threaded · Password Recovery"
                       FontFamily="Consolas" FontSize="11" Foreground="#5A6080"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- PASSWORD SECTION -->
        <Border Grid.Row="1" Background="#16213E" BorderBrush="#0F3460" BorderThickness="1"
                CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="PASSWORD SETUP"
                           Style="{StaticResource LabelStyle}" Margin="0,0,0,10"
                           FontWeight="Bold" Foreground="#6080A0"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Plaintext: " Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPlainPassword" Text="—" Style="{StaticResource ValueStyle}"
                               VerticalAlignment="Center" MinWidth="80"/>
                    <TextBlock Text="   Hash: " Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHash" Text="—" Foreground="#4080C0" FontFamily="Consolas"
                               FontSize="11" VerticalAlignment="Center" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="1" Content="🎲 Generate Password"
                        Style="{StaticResource DarkButton}" Margin="8,0,4,0"
                        Click="BtnGenerate_Click"/>
                <Button Grid.Row="1" Grid.Column="2" Content="📋 Custom Password"
                        Style="{StaticResource DarkButton}" Margin="4,0,0,0"
                        Click="BtnCustom_Click"/>
            </Grid>
        </Border>

        <!-- ATTACK CONTROLS -->
        <Border Grid.Row="2" Background="#16213E" BorderBrush="#0F3460" BorderThickness="1"
                CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="ELAPSED" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtElapsed" Text="00:00.000" Style="{StaticResource ValueStyle}" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="CHECKED" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtChecked" Text="0" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="THREADS" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtThreads" Text="—" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SPEED (k/s)" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtSpeed" Text="—" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnStart" Content="▶  START ATTACK"
                        Style="{StaticResource AccentButton}" Margin="4,0"
                        Click="BtnStart_Click"/>
                <Button Grid.Column="2" x:Name="BtnStop" Content="■  STOP"
                        Style="{StaticResource DarkButton}" Margin="4,0"
                        IsEnabled="False" Click="BtnStop_Click"/>
                <Button Grid.Column="3" Content="📊 Benchmark"
                        Style="{StaticResource DarkButton}" Margin="4,0"
                        Click="BtnBenchmark_Click" x:Name="BtnBenchmark"/>
            </Grid>
        </Border>

        <!-- PROGRESS + RESULT -->
        <Border Grid.Row="3" Background="#16213E" BorderBrush="#0F3460" BorderThickness="1"
                CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PROGRESS" Style="{StaticResource LabelStyle}" FontWeight="Bold" Foreground="#6080A0"/>
                    <TextBlock Grid.Column="1" x:Name="TxtProgressPct" Text="0%" Style="{StaticResource LabelStyle}" Foreground="#E94560"/>
                </Grid>

                <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="100"
                             Background="#0F1535" Foreground="#E94560" BorderThickness="0"
                             Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FOUND: " Style="{StaticResource LabelStyle}" FontWeight="Bold"
                               Foreground="#6080A0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="TxtFoundPassword" Text="Searching..."
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                               Foreground="#00FF88" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- LOG -->
        <Border Grid.Row="4" Background="#0D1117" BorderBrush="#0F3460" BorderThickness="1"
                CornerRadius="6" Padding="4">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#60A080"
                         FontFamily="Consolas" FontSize="11" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap" Padding="8"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
